# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyA_example_key_here

# Your numeric Telegram user ID (get it from @userinfobot). Required.
# The bot auto-leaves any group it was NOT added to by this user.
OWNER_ID=123456789

# ---------------------------------------------------------------------------
# Webhook mode (production only — e.g. Render)
# ---------------------------------------------------------------------------
# Leave BOTH blank for local development: the bot then uses long polling.
# In production set WEBHOOK_URL to the public HTTPS base URL of the service
# (no trailing slash), e.g. https://your-service.onrender.com
WEBHOOK_URL=
# Random secret used as the webhook path and the Telegram secret-token header.
# Generate one with:  openssl rand -hex 32
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Market Summary Feature (optional, on-demand via /marketsummary)
# ---------------------------------------------------------------------------

# CoinGecko Demo API key (optional, get free key at https://www.coingecko.com/en/api)
# Without a key the public rate-limited endpoint is used (still works for daily use)
COINGECKO_API_KEY=

# Newsdata.io API key (optional, get free key at https://newsdata.io/)
# If empty, the news section is omitted from the market summary
NEWSDATA_API_KEY=
